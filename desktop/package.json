{
  "name": "steel-slitting-optimizer",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.steelslitting.optimizer",
    "productName": "Steel Slitting Optimizer",

    "directories": {
      "output": "dist"
    },

    "files": [
      "main.js",
      "../frontend/dist/**/*"
    ],

    "extraResources": [
      {
        "from": "../backend/dist/steel-slitting-backend.exe",
        "to": "backend/steel-slitting-backend.exe"
      }
    ],

    "win": {
      "target": "nsis"
    }
  }
}