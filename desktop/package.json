{
  "name": "steel-slitting-optimizer",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
"build": {
  "appId": "com.steelslitting.optimizer",
  "productName": "Steel Slitting Optimizer",

  "asar": true,

  "files": [
    "main.js",
    "../frontend/dist/**/*"
  ],

  "extraResources": [
    {
      "from": "backend",
      "to": "backend"
    }
  ],

  "win": {
    "target": "nsis"
  },

  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
}